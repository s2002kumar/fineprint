# Raw downloaded source data never goes in git; manifests record hashes + recipes.
data/
# ...except the explorer's published, checksummed exports (site/data/manifest.json)
!site/data/
*.zip
!tests/fixtures/**/*.zip

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Local secrets / environment (database passwords live under $FINEPRINT_DATA/secrets, never here)
secrets/
*.pgpass
pgpass.conf
.env
.env.*
