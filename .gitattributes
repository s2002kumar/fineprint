# Source text normalized to LF everywhere.
* text=auto eol=lf

# Raw source fixtures and evidence are hashed byte-for-byte: never convert line endings.
tests/fixtures/** -text
evidence/** -text

# Published explorer data is checksummed byte-for-byte (site/data/manifest.json).
site/data/** -text

# Self-hosted third-party fonts and their license texts are kept exactly as published upstream.
site/fonts/** -text
